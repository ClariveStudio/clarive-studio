---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RelatedBlogs from '../../components/blog/RelatedBlogs.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blogs');
  return posts.map((post) => ({
    params: { slug: post.data.permalink },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('blogs');
const relatedPosts = allPosts
  .filter(p => p.data.category === post.data.category && p.data.permalink !== post.data.permalink)
  .slice(0, 3)
  .map(p => ({
    title: p.data.title,
    permalink: p.data.permalink,
    pubDate: p.data.pubDate,
    category: p.data.category,
    description: p.data.description
  }));

const latestPosts = allPosts
  .filter(p => p.data.permalink !== post.data.permalink)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5)
  .map(p => ({
    title: p.data.title,
    permalink: p.data.permalink,
    pubDate: p.data.pubDate,
    category: p.data.category,
    description: p.data.description
  }));

const canonicalURL = new URL(`/blog/${post.data.permalink}`, Astro.site);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(post.data.pubDate);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.image.src,
  "datePublished": post.data.pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Clarive Studio",
    "url": Astro.site?.toString()
  },
  "publisher": {
    "@type": "Organization",
    "name": "Clarive Studio",
    "logo": {
      "@type": "ImageObject",
      "url": `${Astro.site}assets/images/logo.png`
    }
  }
};
---

<Layout
  title={`${post.data.title} — Clarive Studio Blog`}
  description={post.data.description}
  canonicalUrl={canonicalURL.toString()}
>
  <header>
    <div class="container">
      <nav>
        <a href="/" class="logo">
          <img src="/assets/images/logo.png" alt="Clarive Studio" class="logo-img" loading="eager">
        </a>
        <ul class="nav-menu" id="nav-menu">
          <li><a href="/#services">Services</a></li>
          <li><a href="/#portfolio">Work</a></li>
          <li><a href="/#process">Process</a></li>
          <li><a href="/#pricing">Pricing</a></li>
          <li><a href="/blog" class="active">Blog</a></li>
        </ul>
        <a href="/#contact" class="nav-cta">
          Book a Call
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <button class="hamburger" id="hamburger" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </nav>
    </div>
  </header>

  <main class="article-page">
    <article class="article">
      <div class="article-header">
        <div class="container">
          <div class="article-header-content">
            <div class="article-breadcrumb">
              <a href="/">Home</a>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18l6-6-6-6"/>
              </svg>
              <a href="/blog">Blog</a>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18l6-6-6-6"/>
              </svg>
              <span>{post.data.category}</span>
            </div>
            <div class="article-meta">
              <span class="article-category">{post.data.category}</span>
              <span class="article-date">{formattedDate}</span>
              <span class="article-read-time">{post.data.description.split(' ').length > 50 ? '5' : '3'} min read</span>
            </div>
            <h1 class="article-title">{post.data.title}</h1>
            <p class="article-excerpt">{post.data.description}</p>
            <div class="article-author">
              <div class="author-avatar">CS</div>
              <div class="author-info">
                <span class="author-name">{post.data.author}</span>
                <span class="author-role">Business Growth Expert</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="article-hero-image">
        <div class="container">
          <img src={post.data.image.src} alt={post.data.imageAlt} loading="eager" />
        </div>
      </div>

      <div class="article-body-wrapper">
        <div class="container">
          <div class="article-layout">
            <div class="article-content">
              <div class="article-body">
                <Content />
              </div>

              <div class="article-tags">
                <span class="tags-label">Tags:</span>
                {post.data.tags.map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <div class="article-share">
                <span class="share-label">Share this article:</span>
                <div class="share-buttons">
                  <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(canonicalURL.toString())}`} target="_blank" rel="noopener" class="share-button" aria-label="Share on Twitter">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 4l11.733 16h4.267l-11.733 -16z"/>
                      <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>
                    </svg>
                  </a>
                  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL.toString())}`} target="_blank" rel="noopener" class="share-button" aria-label="Share on LinkedIn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                      <rect x="2" y="9" width="4" height="12"/>
                      <circle cx="4" cy="4" r="2"/>
                    </svg>
                  </a>
                  <button class="share-button copy-link" aria-label="Copy link" data-url={canonicalURL.toString()}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="article-cta">
                <div class="cta-content">
                  <h3>Ready to Stop Renting Leads?</h3>
                  <p>Get a website that brings you high-quality clients consistently. No middleman, no price wars, just results.</p>
                  <a href="/#contact" class="cta-button">
                    Let's Build Your Website
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>

            <div class="article-sidebar-wrapper">
              <RelatedBlogs relatedPosts={relatedPosts} latestPosts={latestPosts} />
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>

  <footer>
    <div class="container">
      <div class="footer-content">
        <div class="footer-main">
          <div class="footer-brand">
            <img src="/assets/images/logo.png" alt="Clarive Studio" class="footer-logo">
            <p>Design, copy, and strategy synced for conversions. We build focused websites for business owners who want real results.</p>
          </div>
          <div class="footer-links">
            <div class="footer-column">
              <h4>Services</h4>
              <ul>
                <li><a href="/#services">Website Design</a></li>
                <li><a href="/#services">Copywriting</a></li>
                <li><a href="/#services">Landing Pages</a></li>
              </ul>
            </div>
            <div class="footer-column">
              <h4>Resources</h4>
              <ul>
                <li><a href="/blog">Blog</a></li>
                <li><a href="/#portfolio">Work</a></li>
                <li><a href="/#contact">Contact</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2026 Clarive Studio. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

