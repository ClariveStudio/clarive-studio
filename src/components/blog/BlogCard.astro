---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  image: string;
  imageAlt: string;
  permalink: string;
  featured?: boolean;
}

const { title, description, pubDate, category, image, imageAlt, permalink, featured = false } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);
---

<article class={`blog-card ${featured ? 'featured' : ''}`}>
  <a href={`/blog/${permalink}`} class="blog-card-image-link">
    <div class="blog-card-image">
      <img src={image} alt={imageAlt} loading="lazy" />
      <span class="blog-card-category">{category}</span>
      {featured && <span class="blog-card-featured-badge">Featured</span>}
    </div>
  </a>
  <div class="blog-card-content">
    <div class="blog-card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <h3 class="blog-card-title">
      <a href={`/blog/${permalink}`}>{title}</a>
    </h3>
    <p class="blog-card-excerpt">{description}</p>
    <a href={`/blog/${permalink}`} class="blog-card-read-more">
      Read Article
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .blog-card {
    background: var(--card-bg, #fff);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  .blog-card.featured {
    border: 2px solid var(--primary, #6366f1);
  }

  .blog-card-image-link {
    display: block;
    text-decoration: none;
  }

  .blog-card-image {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
  }

  .blog-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-card-image img {
    transform: scale(1.05);
  }

  .blog-card-category {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--primary, #6366f1);
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .blog-card-featured-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--accent, #f59e0b);
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .blog-card-content {
    padding: 24px;
  }

  .blog-card-meta {
    font-size: 0.875rem;
    color: var(--text-muted, #6b7280);
    margin-bottom: 12px;
  }

  .blog-card-title {
    font-family: var(--font-heading, 'Space Grotesk', sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 12px;
  }

  .blog-card-title a {
    color: var(--text-primary, #1f2937);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-card-title a:hover {
    color: var(--primary, #6366f1);
  }

  .blog-card-excerpt {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary, #4b5563);
    margin: 0 0 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary, #6366f1);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .blog-card-read-more:hover {
    gap: 12px;
  }

  .blog-card-read-more svg {
    transition: transform 0.2s ease;
  }

  .blog-card-read-more:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .blog-card-content {
      padding: 20px;
    }

    .blog-card-title {
      font-size: 1.125rem;
    }
  }
</style>