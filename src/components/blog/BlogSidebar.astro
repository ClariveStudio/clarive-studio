---
interface Props {
  categories: { name: string; count: number }[];
  recentPosts: {
    title: string;
    permalink: string;
    pubDate: Date;
    category: string;
  }[];
}

const { categories, recentPosts } = Astro.props;

const formattedDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(date);
---

<aside class="blog-sidebar">
  <div class="sidebar-section">
    <h3 class="sidebar-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      Search
    </h3>
    <div class="search-wrapper">
      <input 
        type="text" 
        id="blog-search" 
        class="search-input" 
        placeholder="Search articles..."
        autocomplete="off"
      />
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
    </div>
    <div id="search-results" class="search-results"></div>
  </div>

  <div class="sidebar-section">
    <h3 class="sidebar-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
      </svg>
      Categories
    </h3>
    <ul class="category-list" id="category-list">
      <li class="category-item active" data-category="all">
        <span class="category-name">All Posts</span>
        <span class="category-count" id="total-count">{categories.reduce((sum, cat) => sum + cat.count, 0)}</span>
      </li>
      {categories.map((category) => (
        <li class="category-item" data-category={category.name}>
          <span class="category-name">{category.name}</span>
          <span class="category-count">{category.count}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-section">
    <h3 class="sidebar-title">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      Recent Posts
    </h3>
    <ul class="recent-posts-list">
      {recentPosts.map((post) => (
        <li class="recent-post-item">
          <a href={`/blog/${post.permalink}`} class="recent-post-link">
            <span class="recent-post-category">{post.category}</span>
            <span class="recent-post-title">{post.title}</span>
            <time class="recent-post-date" datetime={post.pubDate.toISOString()}>
              {formattedDate(post.pubDate)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-cta">
    <h3>Need a Better Lead System?</h3>
    <p>Stop renting leads from platforms. Start owning your customer pipeline.</p>
    <a href="/#contact" class="sidebar-cta-button">Get Your Website</a>
  </div>
</aside>

<style>
  .blog-sidebar {
    position: sticky;
    top: 100px;
  }

  .sidebar-section {
    background: var(--card-bg, #fff);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .sidebar-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading, 'Space Grotesk', sans-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #1f2937);
    margin: 0 0 20px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--border-color, #e5e7eb);
  }

  .sidebar-title svg {
    color: var(--primary, #6366f1);
  }

  .search-wrapper {
    position: relative;
  }

  .search-input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    border: 2px solid var(--border-color, #e5e7eb);
    border-radius: 10px;
    font-size: 0.9375rem;
    background: var(--bg-secondary, #f9fafb);
    color: var(--text-primary, #1f2937);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--primary, #6366f1);
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
  }

  .search-input::placeholder {
    color: var(--text-muted, #9ca3af);
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted, #9ca3af);
    pointer-events: none;
  }

  .search-results {
    margin-top: 12px;
    max-height: 200px;
    overflow-y: auto;
  }

  .search-results:empty {
    display: none;
  }

  .search-results:empty::before {
    content: 'No articles found';
    display: block;
    padding: 12px;
    text-align: center;
    color: var(--text-muted, #6b7280);
    font-size: 0.875rem;
  }

  .search-result-item {
    padding: 10px 12px;
    border-radius: 8px;
    margin-bottom: 4px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .search-result-item:hover {
    background: var(--bg-secondary, #f9fafb);
  }

  .search-result-item a {
    color: var(--text-primary, #1f2937);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .category-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .category-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-bottom: 4px;
  }

  .category-item:hover {
    background: var(--bg-secondary, #f9fafb);
  }

  .category-item.active {
    background: rgba(99, 102, 241, 0.1);
  }

  .category-item.active .category-name {
    color: var(--primary, #6366f1);
    font-weight: 600;
  }

  .category-item.active .category-count {
    background: var(--primary, #6366f1);
    color: white;
  }

  .category-name {
    font-size: 0.9375rem;
    color: var(--text-primary, #1f2937);
  }

  .category-count {
    background: var(--bg-secondary, #f3f4f6);
    color: var(--text-secondary, #6b7280);
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .recent-posts-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recent-post-item {
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
  }

  .recent-post-item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .recent-post-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }

  .recent-post-category {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--primary, #6366f1);
  }

  .recent-post-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary, #1f2937);
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .recent-post-link:hover .recent-post-title {
    color: var(--primary, #6366f1);
  }

  .recent-post-date {
    font-size: 0.75rem;
    color: var(--text-muted, #9ca3af);
  }

  .sidebar-cta {
    background: linear-gradient(135deg, var(--primary, #6366f1) 0%, #4f46e5 100%);
    border-radius: 16px;
    padding: 28px 24px;
    text-align: center;
    color: white;
  }

  .sidebar-cta h3 {
    font-family: var(--font-heading, 'Space Grotesk', sans-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .sidebar-cta p {
    font-size: 0.875rem;
    line-height: 1.5;
    opacity: 0.9;
    margin: 0 0 20px;
  }

  .sidebar-cta-button {
    display: inline-block;
    background: white;
    color: var(--primary, #6366f1);
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sidebar-cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 1024px) {
    .blog-sidebar {
      position: static;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('blog-search') as HTMLInputElement;
  const searchResults = document.getElementById('search-results');
  const categoryItems = document.querySelectorAll('.category-item');
  const blogCards = document.querySelectorAll('.blog-grid .blog-card');

  let allPosts: { title: string; permalink: string; category: string }[] = [];

  blogCards.forEach(card => {
    const title = card.querySelector('.blog-card-title a')?.textContent || '';
    const link = card.querySelector('.blog-card-title a')?.getAttribute('href') || '';
    const category = card.querySelector('.blog-card-category')?.textContent || '';
    allPosts.push({ title, permalink: link, category });
  });

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
    
    if (!query) {
      if (searchResults) searchResults.innerHTML = '';
      blogCards.forEach(card => (card as HTMLElement).style.display = '');
      return;
    }

    const filtered = allPosts.filter(post => 
      post.title.toLowerCase().includes(query) ||
      post.category.toLowerCase().includes(query)
    );

    if (searchResults) {
      if (filtered.length === 0) {
        searchResults.innerHTML = '';
      } else {
        searchResults.innerHTML = filtered.map(post => `
          <div class="search-result-item">
            <a href="${post.permalink}">${post.title}</a>
          </div>
        `).join('');
      }
    }

    blogCards.forEach(card => {
      const title = card.querySelector('.blog-card-title a')?.textContent?.toLowerCase() || '';
      const category = card.querySelector('.blog-card-category')?.textContent?.toLowerCase() || '';
      const matches = title.includes(query) || category.includes(query);
      (card as HTMLElement).style.display = matches ? '' : 'none';
    });
  });

  categoryItems.forEach(item => {
    item.addEventListener('click', () => {
      const category = item.getAttribute('data-category');
      
      categoryItems.forEach(i => i.classList.remove('active'));
      item.classList.add('active');

      if (searchInput) searchInput.value = '';

      blogCards.forEach(card => {
        if (category === 'all') {
          (card as HTMLElement).style.display = '';
        } else {
          const cardCategory = card.querySelector('.blog-card-category')?.textContent;
          (card as HTMLElement).style.display = cardCategory === category ? '' : 'none';
        }
      });

      if (searchResults) searchResults.innerHTML = '';
    });
  });
</script>