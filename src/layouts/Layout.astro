---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  tags?: string[];
  image?: string;
}

const {
  title = "Clarive Studio — Design, Copy & Strategy for Conversions",
  description = "We build focused websites for business owners who want more clarity, fewer revisions, and marketing pages that feel calm yet persuasive.",
  canonicalUrl,
  type = "website",
  publishedTime,
  modifiedTime,
  author = "Clarive Studio",
  tags = [],
  image = "/og-image.png"
} = Astro.props;

const siteUrl = Astro.site || 'https://clarivestudio.com';
const canonical = canonicalUrl ? new URL(canonicalUrl, siteUrl) : new URL(Astro.url.pathname, siteUrl);

const schemaData = type === 'article' && publishedTime ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": publishedTime.toISOString(),
  "dateModified": modifiedTime?.toISOString() || publishedTime.toISOString(),
  "author": {
    "@type": "Organization",
    "name": author,
    "url": siteUrl.toString()
  },
  "publisher": {
    "@type": "Organization",
    "name": "Clarive Studio",
    "url": siteUrl.toString()
  }
} : {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Clarive Studio",
  "description": description,
  "url": canonical.toString(),
  "priceRange": "$$",
  "areaServed": "Worldwide",
  "serviceType": ["Web Design", "Copywriting", "Digital Marketing"]
};

const schemaJson = JSON.stringify(schemaData);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>

  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, siteUrl)}>
  <meta property="og:url" content={canonical}>
  <meta property="og:site_name" content="Clarive Studio">
  {type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime.toISOString()} />
  )}
  {type === 'article' && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime.toISOString()} />
  )}
  {type === 'article' && (
    <meta property="article:author" content={author} />
  )}
  {type === 'article' && tags.map((tag) => (
    <meta property="article:tag" content={tag} />
  ))}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(image, siteUrl)}>

  <meta name="robots" content="index, follow">

  <script type="application/ld+json" set:html={schemaJson}></script>
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>